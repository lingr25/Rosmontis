# Timezone
TZ=Asia/Shanghai

# Optional: set a password to enable x11vnc + noVNC web desktop on 127.0.0.1:6081
# (You can also fetch QR codes directly via POST http://127.0.0.1:3000/get_login_qrcode without VNC)
VNC_PASSWD=

# OneBot v11 Authentication Token (Bearer token for HTTP, WS Server, and Reverse WS Client)
ROSMONTIS_ACCESS_TOKEN=

# Optional: Reverse WebSocket endpoint (e.g. NoneBot2 / Koishi / AstrBot)
# Example: ws://host.docker.internal:8080/onebot/v11/ws
ROSMONTIS_REVERSE_WS_URL=

# Optional: Override official Linux QQ .deb URL (e.g. for arm64 builds)
# QQ_DEB_URL=https://dldir1.qq.com/qqfile/qq/QQNT/Linux/QQ_3.2.32_260508_arm64_01.deb
