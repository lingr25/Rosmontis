# Timezone
TZ=Asia/Shanghai

# OneBot v11 Authentication Token (Bearer token for HTTP, WS Server, and Reverse WS Client)
# Strongly recommended! When left unset while binding non-loopback (e.g. 0.0.0.0 inside Docker),
# Rosmontis Protected Mode automatically generates and persists a random access token on first boot.
# ROSMONTIS_ACCESS_TOKEN=

# Disable high-privilege QQ Web Credential / Cookie / SKey extraction APIs by default (0 = disabled, 1 = enabled)
ROSMONTIS_ENABLE_WEB_CREDENTIAL_API=0

# Optional: Reverse WebSocket endpoint (e.g. NoneBot2 / Koishi / AstrBot)
# Example: ws://host.docker.internal:8080/onebot/v11/ws
# ROSMONTIS_REVERSE_WS_URL=

# Optional: Set to 0 when running in Reverse-WS-only mode (with HTTP server disabled) so HEALTHCHECK skips HTTP probe
# ROSMONTIS_HTTP_ENABLE=1

# Optional: Set a password to enable x11vnc + noVNC web desktop on 127.0.0.1:6081
# (Raw x11vnc RFB :5900 binds strictly to 127.0.0.1 inside the container unless ROSMONTIS_EXPOSE_RAW_VNC=1)
# (You can also fetch QR codes directly via POST http://127.0.0.1:3000/get_login_qrcode without VNC)
# VNC_PASSWD=
# ROSMONTIS_EXPOSE_RAW_VNC=0

# Optional: Override official Linux QQ .deb URL (must be https://; leave unset to auto-resolve & sign latest official .deb)
# QQ_DEB_URL=

# Optional: Pin SHA-256 checksum of /tmp/linuxqq.deb (logged during `docker compose build`)
# Set REQUIRE_QQ_DEB_SHA256=1 in reproducible/production builds to refuse unpinned downloads.
# QQ_DEB_SHA256=
# REQUIRE_QQ_DEB_SHA256=0
